#!/usr/bin/env sh
set -eu

SDK_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CC=${BHARAT_SDK_CC:-cc}

# Default settings
BHARAT_SDK_BACKEND=${BHARAT_SDK_BACKEND:-HOST}
BHARAT_SDK_ARCH=${BHARAT_SDK_ARCH:-}
BHARAT_SDK_BUILD_DIR=${BHARAT_SDK_BUILD_DIR:-}

COMPILE_ONLY=0
COMPUTE_REQ=0

argc=$#
i=0
while [ $i -lt $argc ]; do
    arg="$1"
    shift
    case "$arg" in
        --bh-backend=*)
            BHARAT_SDK_BACKEND="${arg#*=}"
            ;;
        --bh-arch=*)
            BHARAT_SDK_ARCH="${arg#*=}"
            ;;
        -c|-E|-S)
            COMPILE_ONLY=1
            set -- "$@" "$arg"
            ;;
        -lbharat_compute)
            COMPUTE_REQ=1
            # We will handle SDK libs explicitly during linking
            ;;
        *)
            set -- "$@" "$arg"
            ;;
    esac
    i=$((i + 1))
done

if [ "$BHARAT_SDK_BACKEND" != "HOST" ] && [ "$BHARAT_SDK_BACKEND" != "NATIVE" ]; then
    echo "Error: BHARAT_SDK_BACKEND must be HOST or NATIVE" >&2
    exit 1
fi

if [ "$BHARAT_SDK_BACKEND" = "NATIVE" ]; then
    if [ -z "$BHARAT_SDK_ARCH" ]; then
        echo "Error: BHARAT_SDK_ARCH must be specified for NATIVE backend (x86_64, arm64, riscv64, arm32, riscv32)" >&2
        exit 1
    fi
    case "$BHARAT_SDK_ARCH" in
        x86_64|arm64|riscv64|arm32|riscv32)
            ;;
        *)
            echo "Error: Unknown architecture: $BHARAT_SDK_ARCH" >&2
            exit 1
            ;;
    esac

    # Check if compiler exists
    if ! command -v "$CC" >/dev/null 2>&1; then
        echo "Error: Compiler '$CC' not found" >&2
        exit 1
    fi
fi

if [ -z "$BHARAT_SDK_BUILD_DIR" ]; then
    if [ "$BHARAT_SDK_BACKEND" = "HOST" ]; then
        BUILD_DIR="$SDK_ROOT/build-host" # Maintain backward compatibility with the existing hosted quick start where practical
    else
        BUILD_DIR="$SDK_ROOT/build/sdk/$BHARAT_SDK_ARCH-native"
    fi
else
    BUILD_DIR="$BHARAT_SDK_BUILD_DIR"
fi

if [ ! -f "$BUILD_DIR/libbharat_core.a" ]; then
    if [ "$BHARAT_SDK_BACKEND" = "NATIVE" ]; then
        echo "Error: Native SDK libraries not found in $BUILD_DIR" >&2
        echo "Please build them explicitly using the appropriate toolchain." >&2
        exit 1
    else
        # We silently compile for host to maintain quick start if not provided
        cmake -S "$SDK_ROOT" -B "$BUILD_DIR" -DBHARAT_SDK_BACKEND=HOST -DBHARAT_SDK_BUILD_EXAMPLES=OFF -DBHARAT_SDK_BUILD_TESTS=OFF >/dev/null
        cmake --build "$BUILD_DIR" >/dev/null
    fi
fi

if [ "$BHARAT_SDK_BACKEND" = "NATIVE" ]; then
    if [ ! -f "$BUILD_DIR/libbharat_process.a" ]; then
        echo "Error: Incomplete native SDK build in $BUILD_DIR" >&2
        exit 1
    fi
fi

if [ $COMPILE_ONLY -eq 1 ]; then
    exec "$CC" -I"$SDK_ROOT/include" "$@"
else
    # Link logic
    if [ $COMPUTE_REQ -eq 1 ]; then
        exec "$CC" -I"$SDK_ROOT/include" "$@" "$BUILD_DIR/libbharat_compute.a" "$BUILD_DIR/libbharat_process.a" "$BUILD_DIR/libbharat_ipc.a" "$BUILD_DIR/libbharat_device.a" "$BUILD_DIR/libbharat_cap.a" "$BUILD_DIR/libbharat_core.a"
    else
        exec "$CC" -I"$SDK_ROOT/include" "$@" "$BUILD_DIR/libbharat_process.a" "$BUILD_DIR/libbharat_ipc.a" "$BUILD_DIR/libbharat_device.a" "$BUILD_DIR/libbharat_cap.a" "$BUILD_DIR/libbharat_core.a"
    fi
fi
