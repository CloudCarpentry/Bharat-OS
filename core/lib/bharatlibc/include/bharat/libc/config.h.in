#ifndef BHARATLIBC_CONFIG_H
#define BHARATLIBC_CONFIG_H

#define BH_LIBC_ABI_VERSION 1U

#cmakedefine BH_LIBC_ARCH_X86_64 1
#cmakedefine BH_LIBC_ARCH_ARM64 1
#cmakedefine BH_LIBC_ARCH_RISCV64 1
#cmakedefine BH_LIBC_ARCH_ARM32 1
#cmakedefine BH_LIBC_ARCH_RISCV32 1

#cmakedefine BH_LIBC_MEMORY_MMU_FULL 1
#cmakedefine BH_LIBC_MEMORY_MMU_LITE 1
#cmakedefine BH_LIBC_MEMORY_MPU 1

#cmakedefine BH_LIBC_EXECUTION_GP 1
#cmakedefine BH_LIBC_EXECUTION_RT 1
#cmakedefine BH_LIBC_EXECUTION_MIX 1

#cmakedefine BH_LIBC_PROFILE_NANO_MPU 1
#cmakedefine BH_LIBC_PROFILE_EMBEDDED_MMULITE 1
#cmakedefine BH_LIBC_PROFILE_RT_SAFE 1
#cmakedefine BH_LIBC_PROFILE_EDGE_POSIX 1
#cmakedefine BH_LIBC_PROFILE_HOSTED_DESKTOP 1
#cmakedefine BH_LIBC_PROFILE_HOST_TEST 1

#cmakedefine01 BH_LIBC_HAS_FIXED_ALLOCATOR
#cmakedefine01 BH_LIBC_HAS_POSIX_IO
#cmakedefine01 BH_LIBC_HAS_PTHREAD
#cmakedefine01 BH_LIBC_HAS_FLOAT_PRINTF

#endif /* BHARATLIBC_CONFIG_H */
