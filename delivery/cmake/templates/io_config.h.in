#ifndef BHARAT_IO_CONFIG_H
#define BHARAT_IO_CONFIG_H

/* Resolved default policy options based on BHARAT_IO_PROFILE */
#cmakedefine BHARAT_IO_PROFILE_TINY 1
#cmakedefine BHARAT_IO_PROFILE_EMBEDDED 1
#cmakedefine BHARAT_IO_PROFILE_BALANCED 1
#cmakedefine BHARAT_IO_PROFILE_THROUGHPUT 1
#cmakedefine BHARAT_IO_PROFILE_REALTIME 1

#cmakedefine BHARAT_IO_ENABLE_ASYNC 1
#cmakedefine BHARAT_IO_ENABLE_BATCH 1
#cmakedefine BHARAT_IO_ENABLE_CACHE_LAYER 1
#cmakedefine BHARAT_IO_ENABLE_DIRECT 1
#cmakedefine BHARAT_IO_ENABLE_POLLING 1
#cmakedefine BHARAT_IO_ENABLE_HYBRID_COMPLETION 1
#cmakedefine BHARAT_IO_ENABLE_ZERO_COPY 1
#cmakedefine BHARAT_IO_DYNAMIC_ALLOCATION 1

#define BHARAT_IO_MAX_DEVICES @BHARAT_IO_MAX_DEVICES@
#define BHARAT_IO_MAX_QUEUES_PER_DEVICE @BHARAT_IO_MAX_QUEUES_PER_DEVICE@
#define BHARAT_IO_MAX_QUEUE_DEPTH @BHARAT_IO_MAX_QUEUE_DEPTH@
#define BHARAT_IO_MEMORY_BUDGET_KB @BHARAT_IO_MEMORY_BUDGET_KB@

#cmakedefine BHARAT_IO_DRIVER_MEMBLK 1
#cmakedefine BHARAT_IO_DRIVER_VIRTIO_BLK 1
#cmakedefine BHARAT_IO_DRIVER_NVME 1
#cmakedefine BHARAT_IO_DRIVER_SDHOST 1
#cmakedefine BHARAT_IO_DRIVER_AHCI 1

#endif /* BHARAT_IO_CONFIG_H */
