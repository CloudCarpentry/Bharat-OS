/* Generated Bharat-OS Linker Script for RISC-V 32 Sv32 Supervisor
 * Target Board: {{ board.board }}
 * SoC: {{ board.soc }} ({{ board.architecture }} / {{ board.cpu }})
 */

OUTPUT_FORMAT("elf32-littleriscv")
OUTPUT_ARCH(riscv)
ENTRY({{ board.boot.entry }})

SECTIONS
{
    /* OpenSBI payload load offset */
    . = {{ board.memory.ram.origin }} + 0x200000;

    .text ALIGN(4096) :
    {
        KEEP(*(.text.init))
        *(.text)
        *(.text.*)
        *(.fixup)
    }

    .rodata ALIGN(4096) :
    {
        *(.rodata)
        *(.rodata.*)

        . = ALIGN(8);
        __ex_table_start = .;
        KEEP(*(__ex_table))
        __ex_table_end = .;

        . = ALIGN(8);
        __start_bharat_services = .;
        KEEP(*(bharat_services))
        __stop_bharat_services = .;

        . = ALIGN(8);
        __kern_tests_start = .;
        KEEP(*(.kern_tests))
        __kern_tests_end = .;

        . = ALIGN(8);
        __subsys_tests_start = .;
        KEEP(*(.subsys_tests))
        __subsys_tests_end = .;
    }

    .data ALIGN(4096) :
    {
        *(.data)
        *(.data.*)
    }

    .bss ALIGN(65536) :
    {
        bss_start = .;
        __bss_start = .;
        *(.bss)
        *(.bss.*)
        *(COMMON)
        bss_end = .;
        __bss_end = .;
    }

    .pstore ALIGN(4096) (NOLOAD) :
    {
        _pstore_start = .;
        *(.pstore)
        . = . + 4096;
        _pstore_end = .;
    }

    . = ALIGN(4096);
    _end = .;

    /DISCARD/ :
    {
        *(.comment)
        *(.eh_frame)
        *(.note*)
    }
}
